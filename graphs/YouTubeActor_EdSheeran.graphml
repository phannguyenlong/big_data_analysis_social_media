    <edge source="n837" target="n837">
      <data key="e_video_id">orJSJGHjBLI</data>
      <data key="e_comment_id">UgyJ52860fd7TpJIBjh4AaABAg.AMjmKDMYPZcAMjmLmQ1hfD</data>
      <data key="e_edge_type">reply-comment</data>
      <data key="e_vosonTxt_comment">This was written back in the spring of 2000 in Mesquite.  A broken hearted young man, lonely, isolated and too poor to afford a movie ticket sits and pours his heart out in song lyrics as he sits in a café.  On a receipt he writes lyrics and music video concepts.  He sits there all day watching couples laugh and smile, while his heart is bleeding on the pages.  At the end of the day, the cafe closes, he hands them all to the owner as a tip.  The owner asked him to sign his name.  He writes,
A. NOUN MOUSE</data>
      <data key="e_screen_name">@Ninjaneercat</data>
      <data key="e_at_id">NA</data>
    </edge>
    <edge source="n837" target="n837">
      <data key="e_video_id">orJSJGHjBLI</data>
      <data key="e_comment_id">UgyJ52860fd7TpJIBjh4AaABAg.AMjmKDMYPZcAMjmkqB9k_x</data>
      <data key="e_edge_type">reply-comment</data>
      <data key="e_vosonTxt_comment">The inspiration to writing the music video was Michael Jackson Thriller.  I saw the video before I heard any sound and wondered why is this familiar?  I had pure dejavu, then realized it was written by
A. NOUN MOUSE</data>
      <data key="e_screen_name">@Ninjaneercat</data>
      <data key="e_at_id">NA</data>
    </edge>
